<div class="name-forge">
  <form class="nf-form" autocomplete="off">
    <div class="nf-pickers">
    <div class="nf-row">
      <label for="nf-genre"><i class="fa-solid fa-masks-theater"></i> {{localize "NF.Genre"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.Genre'}}"></i></label>
      <select id="nf-genre" name="genre">
        {{#each genres}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    {{#if showCategory}}
    <div class="nf-row">
      <label for="nf-category"><i class="fa-solid fa-layer-group"></i> {{localize "NF.Category"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.Category'}}"></i></label>
      <select id="nf-category" name="category">
        {{#each categories}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}
    </div>

    <div class="nf-row">
      <label id="nf-type-label"><i class="fa-solid fa-signature"></i> {{localize "NF.NameType"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.NameType'}}"></i></label>
      <div class="nf-combo" id="nf-type-combo">
        <button type="button" class="nf-combo-trigger" id="nf-type-trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="nf-type-label">
          <span class="nf-combo-value">{{typeLabel}}</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="nf-combo-panel" id="nf-type-panel" hidden>
          <input type="search" class="nf-combo-search" id="nf-type-search" placeholder="{{localize 'NF.SearchNameType'}}" autocomplete="off" />
          <ul class="nf-combo-list" id="nf-type-list" role="listbox">
            {{#each groups}}
            <li class="nf-combo-group">{{this.label}}</li>
            {{#each this.options}}
            <li class="nf-combo-option" role="option" data-value="{{this.value}}" data-label="{{this.label}}" {{#if this.selected}}aria-selected="true"{{/if}}>{{this.label}}</li>
            {{/each}}
            {{/each}}
          </ul>
        </div>
      </div>
    </div>

    <div class="nf-options">
      {{#if showCompound}}
      <label class="nf-switch" for="nf-compound">
        <input type="checkbox" role="switch" id="nf-compound" name="compound" {{#if compound}}checked{{/if}} />
        <span class="nf-switch-track"></span>
        <i class="fa-solid fa-user-tag"></i> {{localize "NF.CompoundNames"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.Full'}}"></i>
      </label>
      {{/if}}
      <label class="nf-switch" id="nf-source-switch" for="nf-source" {{#unless sourceAvailable}}hidden{{/unless}}>
        <input type="checkbox" role="switch" id="nf-source" name="source" {{#if sourceReal}}checked{{/if}} />
        <span class="nf-switch-track"></span>
        <i class="fa-solid fa-book-open"></i> {{localize "NF.SourceReal"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.Real'}}"></i>
      </label>
    </div>

    <div class="nf-actionbar">
      <div class="nf-count">
        <label for="nf-count"><i class="fa-solid fa-hashtag"></i> {{localize "NF.Count"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.Count'}}"></i></label>
        <input type="number" id="nf-count" name="count" min="1" max="30" value="{{count}}" />
      </div>
      <button type="button" class="nf-generate nf-btn-generate" data-action="generate">
        <i class="fa-solid fa-dice"></i> {{localize "NF.Generate"}}
      </button>
    </div>
  </form>

  <div class="nf-results-wrap">
    <div class="nf-results-header">
      <span class="nf-results-title">{{localize "NF.Results"}} <span class="nf-results-count"></span></span>
      <button type="button" class="nf-copy-all" data-action="copy-all" hidden><i class="fa-regular fa-copy"></i> {{localize "NF.CopyAll"}}</button>
    </div>
    <ol class="nf-results"></ol>
  </div>

  {{#if showActorControls}}
  <div class="nf-actor-row">
    <label for="nf-actor-type">{{localize "NF.CreateAs"}} <i class="fa-regular fa-circle-question nf-help" tabindex="0" data-tooltip="{{localize 'NF.Tip.CreateAs'}}"></i></label>
    <select id="nf-actor-type" name="actorType">
      {{#each actorTypes}}
      <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
</div>
